#!/usr/bin/env bash
# Node on PATH may be older than 22. Prefer a Node 22 binary when it is.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

pick_node() {
  if [[ -n "${BLUEPRINT_NODE:-}" ]]; then
    echo "$BLUEPRINT_NODE"
    return
  fi
  if command -v node >/dev/null 2>&1; then
    local major
    major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
    if [[ "$major" -ge 22 ]]; then
      command -v node
      return
    fi
  fi
  local nvm="${HOME}/.nvm/versions/node/v22.15.1/bin/node"
  if [[ -x "$nvm" ]]; then
    echo "$nvm"
    return
  fi
  echo "blueprint-scene needs Node.js 22 or newer" >&2
  exit 1
}

NODE="$(pick_node)"
export NODE_NO_WARNINGS=1
exec "$NODE" --experimental-strip-types "$ROOT/src/cli.ts" "$@"
