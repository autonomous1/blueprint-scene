{
  "name": "blueprint-scene",
  "version": "0.1.7",
  "type": "module",
  "description": "Bake Inkscape building plans and GLB meshes into placement JSON.",
  "bin": {
    "blueprint-scene": "./dist/cli.js"
  },
  "files": ["dist", "bin"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "NODE_NO_WARNINGS=1 node --test test/*.test.ts",
    "codemap:check": "node scripts/codemap.ts --check",
    "codemap": "node scripts/codemap.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bake": "node src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.2"
  }
}
